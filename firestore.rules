rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ─────────────────────────────────────────────────────

    // Check if the caller is an authenticated admin in /admins collection
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Check if the caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // ─── CONTENT & BOOKS COLLECTIONS ──────────────────────────────────────────
    // Public read for published items only; admin can read/write all
    match /content/{contentId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();
    }

    match /books/{bookId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();
    }

    // ─── CATEGORIES COLLECTION ────────────────────────────────────────────────
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── DEALS COLLECTION ─────────────────────────────────────────────────────
    match /deals/{dealId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── STORIES COLLECTION ───────────────────────────────────────────────────
    match /stories/{storyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── ORDERS COLLECTION ────────────────────────────────────────────────────
    // Security: Only read by the owner or admin.
    // Writes (creation & marking PAID) happen exclusively via Firebase Cloud Functions (Admin SDK).
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.customerEmail == request.auth.token.email ||
        resource.data.buyerEmail == request.auth.token.email ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // ─── USER ENTITLEMENTS COLLECTION ─────────────────────────────────────────
    // Source of truth for digital book ownership
    // Security: Users can only read their own entitlement doc.
    // Writes happen exclusively via Firebase Cloud Functions / Admin SDK upon verified payment.
    match /userEntitlements/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // ─── USERS COLLECTION & SUBCOLLECTIONS ────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Users can update their basic profile, but CANNOT elevate roles or inject entitlements
      allow create, update: if isAuthenticated() && (
        (request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'admin', 'permissions', 'books', 'entitlements'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      // Library subcollection:
      // Users can read their library and update playback timestamps (lastPosition, lastPlayedAt, lastAccessedAt)
      // New book entitlement creation is restricted to Admin SDK / Cloud Functions.
      match /library/{contentId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
        allow update: if isAuthenticated() && request.auth.uid == userId &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastPosition', 'lastPlayedAt', 'lastChapterId', 'lastAccessedAt']);
        allow write: if isAdmin();
      }

      match /myBooks/{bookId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
        allow write: if isAdmin();
      }
    }

    // ─── ADMINS COLLECTION ────────────────────────────────────────────────────
    match /admins/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // ─── SETTINGS COLLECTION ──────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
