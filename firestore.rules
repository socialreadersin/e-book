rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ─────────────────────────────────────────────────────

    // Check if the caller is an authenticated admin (has a document in /admins)
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Check if the caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the caller is the buyer of the order being accessed
    function isOrderOwner(orderData) {
      return isAuthenticated() &&
             (request.auth.uid == orderData.userId ||
              request.auth.token.email == orderData.buyerEmail ||
              request.auth.token.email == orderData.customerEmail);
    }

    // ─── BOOKS COLLECTION ─────────────────────────────────────────────────────
    // Public read for published books only; admin can read/write all
    match /books/{bookId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();
    }

    // ─── CATEGORIES COLLECTION ────────────────────────────────────────────────
    // Public read; admin write only
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── DEALS COLLECTION ─────────────────────────────────────────────────────
    // Public read of active deals; admin write
    match /deals/{dealId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── STORIES COLLECTION ───────────────────────────────────────────────────
    // Public read; admin write
    match /stories/{storyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── ORDERS COLLECTION ────────────────────────────────────────────────────
    // SECURITY:
    //   create → ONLY authenticated users (prevents anonymous fake orders)
    //            + strict field validation (amount > 0, required fields present)
    //            + status must be 'pending' on creation (no client marking 'completed')
    //   read   → authenticated user who is the buyer, OR admin
    //   update → admin only (order status updates, including payment confirmation)
    //   delete → admin only
    match /orders/{orderId} {
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasAll(['orderId', 'bookId', 'amount', 'status', 'customerEmail'])
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.status == 'pending'
                    && request.resource.data.customerEmail is string
                    && request.resource.data.customerEmail.size() > 3;

      allow read: if isAuthenticated() && isOrderOwner(resource.data) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ─── USER ENTITLEMENTS COLLECTION ────────────────────────────────────────
    // Tracks which books each user has purchased (used to grant library access)
    // In production (Cloud Functions deployed): write is handled server-side by Admin SDK.
    // Client-side write is allowed for authenticated owner only — enables sandbox mode.
    match /userEntitlements/{userId} {
      // Authenticated user can only read their own entitlements
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Owner can write their own entitlements (sandbox/demo mode fallback)
      // When Cloud Functions are deployed, you may tighten this to `if isAdmin()`
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ─── ADMINS COLLECTION ────────────────────────────────────────────────────
    // Admin user list; read/write requires existing admin
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }

    // ─── SETTINGS COLLECTION ─────────────────────────────────────────────────
    // Store-level settings (non-sensitive); public read, admin write
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
